{
  "name": "Fortran",
  "scopeName": "source.fortran",
  "type": "tree-sitter",
  "parser": "tree-sitter-fortran",
  "injectionNames": ["fortran"],
  "fileTypes": ["f", "f90", "f95", "f03", "f08", "f77", "for", "fpp"],
  "comments": {
    "start": "! "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:stadelmanma/tree-sitter-fortran#v0.6.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "fortran.wasm",
    "highlightsQuery": "fortran-highlights.scm",
    "foldsQuery": "fortran-folds.scm",
    "indentsQuery": "fortran-indents.scm",
    "tagsQuery": "fortran-tags.scm",
    "localsQuery": "fortran-locals.scm"
  }
}
